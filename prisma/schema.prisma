// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  password         String
  avatar           String?
  phone            String?
  bio              String?
  designation      String?
  dateOfBirth      DateTime?
  gender           String?
  jobTitle         String?
  role             UserRole          @default(USER)
  status           UserStatus        @default(ACTIVE)
  isVerified       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  sentInvitations  Invitation[]      @relation("UserInvitations")
  invitations      Invitation[]
  createdProjects  Project[]         @relation("CreatedProjects")
  projectMembers   ProjectMember[]
  refreshTokens    RefreshToken[]
  createdTasks     Task[]            @relation("CreatedTasks")
  assignedTasks    Task[]            @relation("AssignedTasks")
  projects         Project[]
  taskComments     TaskComment[]
  notifications    Notification[]
  activityLogs     ActivityLog[]
  files            File[]
}

model Workspace {
  id          String          @id @default(uuid())
  name        String
  slug        String          @unique
  logo        String?
  status      WorkspaceStatus @default(ACTIVE)
  description String?
  ownerId     String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner            User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  workspaceMembers WorkspaceMember[]
  invitations      Invitation[]
  projects         Project[]
  activityLogs     ActivityLog[]
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
}

model Project {
  id String @id @default(uuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  name        String
  description String?
  status      ProjectStatus @default(PLANNING)

  createdBy String
  creator   User   @relation("CreatedProjects", fields: [createdBy], references: [id])

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  projectMembers ProjectMember[]
  tasks          Task[]
  user           User?           @relation(fields: [userId], references: [id])
  userId         String?
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  userId    String
  role      ProjectRole @default(DEVELOPER)
  joinedAt  DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model Invitation {
  id          String           @id @default(uuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id])
  invitedBy   String
  inviter     User             @relation("UserInvitations", fields: [invitedBy], references: [id])
  email       String
  role        WorkspaceRole
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  userId      String?

  user User? @relation(fields: [userId], references: [id])
}

model Task {
  id          String  @id @default(uuid())
  title       String
  description String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assignedTo String?
  assignee   User?   @relation("AssignedTasks", fields: [assignedTo], references: [id])

  createdBy String
  creator   User   @relation("CreatedTasks", fields: [createdBy], references: [id])

  priority TaskPriority @default(MEDIUM)
  status   TaskStatus   @default(TODO)
  dueDate  DateTime?
  order    Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskComments TaskComment[]
  files        File[]
}

model TaskComment {
  id String @id @default(uuid())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  title     String
  message   String
  type      NotificationType
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model ActivityLog {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  action    ActivityAction
  entity    ActivityEntity
  entityId  String
  metadata  Json?
  createdAt DateTime       @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model File {
  id String @id @default(uuid())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id])

  fileName String
  url      String
  publicId String

  uploadedBy String
  uploader   User   @relation(fields: [uploadedBy], references: [id])

  createdAt DateTime @default(now())
}

enum UserRole {
  SYSTEM_ADMIN
  ADMIN
  USER
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum ProjectRole {
  PROJECT_ADMIN
  DEVELOPER
  VIEWER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  DELETED
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_COMMENT
  TASK_DELETED

  WORKSPACE_INVITATION

  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_MEMBER_REMOVED
  PROJECT_ROLE_UPDATED
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE

  LOGIN
  LOGOUT
  INVITE
  ASSIGNED
  COMMENT

  ADD_MEMBER
  UPDATE_ROLE
  REMOVE_MEMBER

  ASSIGN_TASK
  CHANGE_STATUS

  ACCEPT_INVITATION
}

enum ActivityEntity {
  WORKSPACE
  PROJECT
  PROJECT_MEMBER
  TASK
  COMMENT
  INVITATION
}
